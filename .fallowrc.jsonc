{
  "$schema": "./node_modules/fallow/schema.json",
  // Framework and package.json entries are discovered; these are the ones
  // discovery cannot see. src/routes/ is absent on purpose: the tanstack-router
  // plugin seeds the route files itself and leaves the `-` directories beside
  // them out, so their exports get checked like any other module. A glob here
  // would have to exclude those directories, and `!` in this list does nothing:
  // `fallow list --entry-points` prints the same entries with and without it.
  "entry": [
    "scripts/**/*.{ts,js}",
    ".github/scripts/**/*.ts",
    "src/shared/ui/**/*.{ts,tsx}",
    "src/lib/utils.ts",
    "src/test/**/*.{ts,tsx}",
  ],
  // Vendored skill payloads: nothing in this repository imports them, and the
  // next update to the skill overwrites whatever a cleanup did to them.
  "ignorePatterns": [".claude/skills/**"],
  // Read by the react-doctor binary at startup, run by
  // .claude/hooks/scoped-guidance/scoped-guidance.sh and by the PreToolUse hook
  // .claude/settings.json registers for pre-bash-guard, and loaded by the void
  // CLI and plugin (the config, the env schema, the D1 schema the `@schema`
  // alias names, and the Worker entry `void.config.ts` names as
  // `cloudflare.main`) and by Mootant as its config, none of which an import
  // graph reaches.
  "dynamicallyLoaded": [
    "doctor.config.ts",
    ".claude/hooks/scoped-guidance/scoped-guidance.entry.ts",
    ".claude/hooks/pre-bash-guard/pre-bash-guard.entry.ts",
    "void.config.ts",
    "src/server.entry.ts",
    "mootant.config.ts",
    "env.ts",
    "db/schema.ts",
  ],
  "ignoreDependencies": [
    // Named as strings in the lint config's `jsPlugins` block, which fallow
    // reads as configuration data rather than as imports.
    "@nkzw/eslint-plugin",
    "@shadcn/lint",
    "@tanstack/eslint-plugin-query",
    "@totto2727/oxlint",
    "oxlint-tailwindcss",
    // Run as the `effect-tsgo` binary and read for its `schema.json` by path,
    // so no import names it.
    "@effect/tsgo",
    // Restates the exact tsrs version vite-plus depends on, so the pin check
    // can compare the two.
    "tsrs",
    // peerDependency of @hookform/resolvers, whose standard-schema/dist/*.d.ts
    // imports StandardSchemaV1 from it. No file here names it, so dropping it
    // fails the type check rather than the analysis.
    "@standard-schema/spec",
  ],
  "rules": {
    // The rule predicts that a production install omitting devDependencies
    // breaks an import. `bun run deploy` uploads a bundled Worker, so no
    // install runs against the deployment at all, and what it reports here is
    // reached from a dev-only guard, a test or a script in any case.
    "dev-dependencies-in-production": "off",
  },
  "duplicates": {
    "near": true,
    // A five-field `type` declaration is 20 tokens, so fallow's default floor
    // of 50 left a row shape copied between modules unreported. This one
    // reaches it.
    "minTokens": 20,
    // shadcn writes this directory, so a clone removed here comes back with the
    // next `shadcn add`.
    "ignore": ["src/shared/ui/**"],
    // src/ reports no clone group at all, so this rejects the first one that
    // appears: the smallest group `minLines` allows still covers a larger share
    // of src/ than this. It is not 0 because 0 turns the ceiling off, and
    // `--fail-on-issues` does not cover duplication: a run reporting clone
    // groups exits 0 under it.
    "threshold": 0.01,
  },
}
