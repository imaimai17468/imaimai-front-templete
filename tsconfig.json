              "src/routes/**/-gateway/**/*.tsx",
              "src/lib/**/*.ts",
              "src/lib/**/*.tsx",
              "src/test/**/*.ts",
              "src/test/**/*.tsx",
              "src/shared/entities/**/*.test.ts",
              "src/routes/**/-entities/**/*.test.ts"
