    "check:fix": "vp check --fix",
    "check:pins": "bun scripts/check-toolchain-pins.entry.ts",
    "check:shell": "git ls-files -z '*.sh' | xargs -0r shellcheck -x",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test --run --coverage",
    "mutate": "bun scripts/mutate/mutate.entry.ts",
    "rename-project": "bun scripts/rename-project/rename-project.entry.ts",
    "smoke": "bun scripts/smoke/smoke.entry.ts",
    "dead-code": "fallow dead-code",
