{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "generate-routes": "tsr generate",
    "dev": "vp dev",
    "build": "vp build",
    "bundle:analyze": "vp build && wrangler deploy --dry-run --outdir .wrangler/bundle-analysis --metafile .wrangler/bundle-analysis/meta.json",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt .",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "check:pins": "bun scripts/check-toolchain-pins.ts",
    "typecheck": "vp check --no-fmt --no-lint",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "cf-typegen:check": "wrangler types --check --env-interface CloudflareEnv",
    "test": "vp test --run --coverage",
    "knip": "knip",
    "doctor": "react-doctor",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:pull": "drizzle-kit pull",
    "db:push:local": "wrangler d1 migrations apply DB --local",
    "preview": "vp build && vp preview",
    "deploy": "vp build && wrangler deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-start": "1.168.48",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.33.0",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.83.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-cli": "1.167.32",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.4",
    "jsdom": "30.0.1",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.12",
    "react-grab": "0.2.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.110.0"
