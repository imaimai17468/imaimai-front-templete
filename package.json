    "prepare": "lefthook install",
    "generate-routes": "tsr generate",
    "dev": "PORTLESS_HTTPS=0 PORTLESS_PORT=1355 portless run vp dev",
    "dev:https": "PORTLESS_HTTPS=1 portless run vp dev",
