{
  "permissions": {
    "allow": [
      "mcp__aegis__*",
      "mcp__aegis-admin__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "WebSearch",
      "WebFetch",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh api:*)",
      "Bash(gh run view:*)",
      "Bash(bun run *)",
      "Bash(bun remove:*)",
      "Bash(bun pm:*)",
      "Bash(bun install:*)",
      "Bash(wrangler types:*)",
      "Bash(wrangler d1 list:*)",
      "Bash(wrangler tail:*)",
      "Bash(find:*)",
      "Bash(ffmpeg:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout .)",
      "Bash(git checkout --:*)",
      "Bash(git restore .)",
      "Bash(git restore --:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase -i:*)",
      "Bash(sudo:*)",
      "Bash(chmod -R:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.claude/.review-stamp)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git revert:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue:*)",
      "Bash(bun add:*)",
      "Bash(bunx:*)",
      "Bash(bun run deploy)",
      "Bash(bun run deploy:*)",
      "Bash(bun run preview)",
      "Bash(bun run preview:*)",
      "Bash(bun run db:push)",
      "Bash(bun run db:push:*)",
      "Bash(bun run db:generate)",
      "Bash(bun run db:generate:*)",
      "Bash(drizzle-kit generate:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler d1 execute:*)",
      "Bash(wrangler r2:*)",
      "Bash(wrangler secret:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-env-check.sh",
            "timeout": 15,
            "statusMessage": "Env check: gate dependencies + session marker reset..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-aegis-hydrate.sh",
            "timeout": 120,
            "statusMessage": "Aegis hydrate: building local knowledge base from aegis-share/source if missing..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-gate.sh",
            "timeout": 5,
            "statusMessage": "Prompt gate: clearing aegis stamp + AGENTS.md pointer..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh",
            "timeout": 120,
            "statusMessage": "Stop gate: typecheck / lint / format / knip / similarity + aegis sync check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__aegis__aegis_compile_context|mcp__aegis-admin__aegis_compile_context|MCP:aegis_compile_context",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-aegis-compile-guard.sh",
            "timeout": 5,
            "statusMessage": "Pre-aegis guard: intent_tags check + review stamp clear..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-agent-aegis-guard.sh",
            "timeout": 5,
            "statusMessage": "Pre-agent guard: confirming aegis_compile_context invocation..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-agent-review-clear.sh",
            "timeout": 5,
            "statusMessage": "Review gate: starting a cycle, clearing the previous stamp..."
          }
        ]
      },
      {
        "matcher": "Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-guard.sh",
            "timeout": 30,
            "statusMessage": "Bash guard: .env protection + review gate check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__aegis__aegis_compile_context|mcp__aegis-admin__aegis_compile_context|MCP:aegis_compile_context",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-aegis-compile.sh",
            "timeout": 3,
            "statusMessage": "Post-aegis: gate stamp + near-miss warn..."
          }
        ]
      },
      {
        "matcher": "mcp__aegis-admin__aegis_sync_docs|mcp__aegis-admin__aegis_import_doc|MCP:aegis_sync_docs|MCP:aegis_import_doc",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-aegis-share-sync.sh",
            "timeout": 120,
            "statusMessage": "Aegis share sync: DB -> aegis-share/ (format -> lint -> materialize -> export)..."
          }
        ]
      },
      {
        "matcher": "Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-bash-stamp-consume.sh",
            "timeout": 15,
            "statusMessage": "Review gate: consume stamp when a commit leaves the tree clean..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-agent-review-stamp.sh",
            "timeout": 3,
            "statusMessage": "Review gate: stamping the commit gate after the review..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "plansDirectory": "./.claude/plans"
}
