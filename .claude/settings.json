{
  "permissions": {
    "allow": [
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "mcp__claude-in-chrome__*",
      "mcp__cloudflare-observability__*",
      "WebSearch",
      "WebFetch",
      "Bash(bun .claude/skills/dispatch-run/scripts/orchestrate.ts *)",
      "Bash(bun run setup)",
      "Bash(bun run check)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run lint)",
      "Bash(bun run dead-code)",
      "Bash(bun run dupes)",
      "Bash(memory_pressure)",
      "Bash(gh pr merge --squash *)",
      "Bash(bun run format)",
      "Bash(git fetch *)",
      "Bash(actionlint *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(npx -y modern-web-guidance@latest *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf src)",
      "Bash(rm -fr /)",
      "Bash(rm -fr ~)",
      "Bash(rm -fr .)",
      "Bash(rm -fr .git)",
      "Bash(rm -fr src)",
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Bash(git add .env*)",
      "Bash(git add * .env*)",
      "Bash(find)",
      "Bash(find -*)",
      "Bash(find .)",
      "Bash(find . *)",
      "Bash(find ./)",
      "Bash(find ./ *)",
      "Bash(find *..*)",
      "Bash(find /*)",
      "Bash(find * /*)",
      "Bash(find ~*)",
      "Bash(find * ~*)",
      "Bash(find $*)",
      "Bash(find * $*)",
      "Bash(find * .)",
      "Bash(find * . *)",
      "Bash(find * ./)",
      "Bash(find * ./ *)",
      "Bash(find `*)",
      "Bash(find * `*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(find * -delete)",
      "Bash(find * -delete *)",
      "Bash(find * -fprint *)",
      "Bash(find * -fprint0 *)",
      "Bash(find * -fprintf *)",
      "Bash(find * -fls *)",
      "Bash(git add -A*)",
      "Bash(git add * -A*)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add * --all)",
      "Bash(git add * --all *)",
      "Bash(git add -u*)",
      "Bash(git add * -u*)",
      "Bash(git add --update*)",
      "Bash(git add * --update*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add * .)",
      "Bash(git add * . *)",
      "Bash(git add ./)",
      "Bash(git add :/)",
      "Bash(git commit -a*)",
      "Bash(git commit --all)",
      "Bash(git commit --all *)",
      "Bash(git commit * -a)",
      "Bash(git commit * -a -*)",
      "Bash(git commit * --all)",
      "Bash(git commit * --all -*)",
      "Bash(git commit * .)",
      "Bash(git rm * .)",
      "Bash(git -C * add -A*)",
      "Bash(git -C * add --all)",
      "Bash(git -C * add --all *)",
      "Bash(git -C * add -u*)",
      "Bash(git -C * add --update*)",
      "Bash(git -C * add .)",
      "Bash(git -C * add . *)",
      "Bash(git -C * commit -a*)",
      "Bash(git -C * commit --all)",
      "Bash(git -C * commit --all *)"
    ],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-env-check/session-start-env-check.sh",
            "timeout": 15,
            "statusMessage": "Env check: gate dependencies..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scoped-guidance/scoped-guidance.sh",
            "timeout": 15,
            "statusMessage": "Scoped guidance: forget which rules this session was pointed at, after compaction..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate/stop-gate.sh",
            "timeout": 240,
            "statusMessage": "Stop gate: typecheck / lint / format / Effect..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "jq -j '.tool_input.command // empty' | bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-guard/pre-bash-guard.entry.ts\"",
            "timeout": 30,
            "statusMessage": "Bash guard: protected env files named outside git and gh prose..."
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scoped-guidance/scoped-guidance.sh",
            "timeout": 15,
            "statusMessage": "Scoped guidance: point at the guidance the call reaches..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scoped-guidance/scoped-guidance.sh",
            "timeout": 15,
            "statusMessage": "Scoped guidance: point at the guidance a changed file falls under..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scoped-guidance/scoped-guidance.sh",
            "timeout": 15,
            "statusMessage": "Scoped guidance: point at the guidance a prompt brings in..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "modern-web-guidance@claude-plugins-official": true
  },
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "plansDirectory": "./.claude/plans",
  "claudeMdExcludes": ["**/.claude/worktrees/**"]
}
