# Development placeholders only. Copy this file to a local working copy and keep
# the values dummy: production secrets never live in the working tree, they are
# read from the environment `bun run deploy` runs in (see docs/DEPLOYMENT.md).
# This file is the canonical list of variable NAMES — keep it in sync whenever a
# new one is introduced.
#
# DRIZZLE_D1_API_TOKEN below is the one exception to "dummy values only": it is a
# real credential that drizzle-kit needs for remote schema commands. Scope it to
# D1 edit on the single database, and remove or rotate it when that work is done.

# Better Auth
# (Better Auth takes the base URL from each request, so there is no BETTER_AUTH_URL)
BETTER_AUTH_SECRET=your_better_auth_secret

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudflare D1 (for drizzle-kit). Not named CLOUDFLARE_*: Alchemy reads
# CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN ahead of its login profile, and
# this token can edit D1 alone.
DRIZZLE_D1_ACCOUNT_ID=your_cloudflare_account_id
DRIZZLE_D1_DATABASE_ID=your_d1_database_id
DRIZZLE_D1_API_TOKEN=your_cloudflare_api_token
